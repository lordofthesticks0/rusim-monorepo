VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SHA-512 hex digest (128 lowercase hex characters) of the device token used to
# sign in to the dashboard. Stored in device_data.devices.token_hash, which only
# ever stores the digest, never the plaintext token.
#
# Apply it to the database with:
#   bun run set-dev-token
#
# Generate one from a token with:
#   printf 'your-token' | sha512sum | cut -d' ' -f1
DEV_0_TOKEN_HASH=